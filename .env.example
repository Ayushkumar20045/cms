# Copy to .env and replace every value. Never commit .env.

POSTGRES_DB=gbu
POSTGRES_USER=gbu
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me

# At least 32 random characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# true in production (HTTPS only)
COOKIE_SECURE=false

# Development seed accounts (created by `python -m app.seed`). Development only; never use in production.
SEED_SUPER_ADMIN_LOGIN_ID=SADM-DEMO-001
SEED_SUPER_ADMIN_PASSWORD=change-me
SEED_ADMIN_LOGIN_ID=ADM-DEMO-001
SEED_ADMIN_PASSWORD=change-me
SEED_STUDENT_LOGIN_ID=STU-DEMO-001
SEED_STUDENT_PASSWORD=change-me
SEED_WARDEN_LOGIN_ID=WDN-DEMO-001
SEED_WARDEN_PASSWORD=change-me
SEED_CARETAKER_LOGIN_ID=CTK-DEMO-001
SEED_CARETAKER_PASSWORD=change-me
